#!/usr/bin/env bash
# Update Homebrew formula after a release
source "$(dirname "$0")/lib.sh"

DRY_RUN=false
VERSION=""
TAP_PATH="${TAP_PATH:-${HOME}/src/rsanheim/homebrew-tap}"

show_help() {
    cat <<EOF
Usage: script/update-homebrew [--dry-run] <X.Y.Z>

Update the local formula from published release archives. Does not commit or push.

  --dry-run   Download and hash archives without changing the formula
  -h, --help  Show help

Set TAP_PATH to override ~/src/rsanheim/homebrew-tap.
EOF
}

main() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            --dry-run)
                DRY_RUN=true
                shift
                ;;
            -*)
                echo "Unknown option: $1"
                echo "Run 'update-homebrew --help' for usage."
                exit 1
                ;;
            *)
                VERSION="$1"
                shift
                ;;
        esac
    done

    if [[ -z "$VERSION" ]]; then
        echo "Error: version required"
        echo "Run 'update-homebrew --help' for usage."
        exit 1
    fi

    if ! [[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "Error: Version must be in format X.Y.Z (e.g., 0.7.7)"
        exit 1
    fi

    echo "=== Updating Homebrew formula for v${VERSION} ==="

    # Download and compute SHA256
    local DARWIN_ARM64_URL="https://github.com/rsanheim/git-all/releases/download/v${VERSION}/git-all-${VERSION}-darwin-arm64.tar.gz"
    local DARWIN_X86_64_URL="https://github.com/rsanheim/git-all/releases/download/v${VERSION}/git-all-${VERSION}-darwin-x86_64.tar.gz"
    local LINUX_ARM64_URL="https://github.com/rsanheim/git-all/releases/download/v${VERSION}/git-all-${VERSION}-linux-arm64.tar.gz"
    local LINUX_X86_64_URL="https://github.com/rsanheim/git-all/releases/download/v${VERSION}/git-all-${VERSION}-linux-x86_64.tar.gz"

    echo "Computing SHA256 hashes..."
    echo ""

    fetch_sha() {
        local label="$1"
        local url="$2"
        echo "Downloading ${label} tarball..." >&2
        curl -fsSL "$url" | shasum -a 256 | cut -d' ' -f1
    }

    local DARWIN_ARM64_SHA
    DARWIN_ARM64_SHA=$(fetch_sha "darwin arm64" "$DARWIN_ARM64_URL")

    local DARWIN_X86_64_SHA
    DARWIN_X86_64_SHA=$(fetch_sha "darwin x86_64" "$DARWIN_X86_64_URL")

    local LINUX_ARM64_SHA
    LINUX_ARM64_SHA=$(fetch_sha "linux arm64" "$LINUX_ARM64_URL")

    local LINUX_X86_64_SHA
    LINUX_X86_64_SHA=$(fetch_sha "linux x86_64" "$LINUX_X86_64_URL")

    cat <<EOF

SHA256 hashes:
  darwin arm64:   ${DARWIN_ARM64_SHA}
  darwin x86_64:  ${DARWIN_X86_64_SHA}
  linux arm64:    ${LINUX_ARM64_SHA}
  linux x86_64:   ${LINUX_X86_64_SHA}

EOF

    local FORMULA="${TAP_PATH}/Formula/git-all.rb"

    if [[ ! -f "$FORMULA" ]]; then
        echo "Formula not found at ${FORMULA}"
        echo "Set TAP_PATH or create the tap first."
        exit 1
    fi

    echo "Updating formula..."

    # Homebrew infers the version from concrete URLs; an explicit version is redundant.
    if $DRY_RUN; then
        echo "[dry-run] awk (update versioned URLs and sha256 hashes) $FORMULA"
    else
        awk \
            -v version="$VERSION" \
            -v darwin_arm64="$DARWIN_ARM64_SHA" \
            -v darwin_x86="$DARWIN_X86_64_SHA" \
            -v linux_arm64="$LINUX_ARM64_SHA" \
            -v linux_x86="$LINUX_X86_64_SHA" '
            /^[[:space:]]*version "/ { next }
            /^[[:space:]]*url "/ {
                sub(/\/download\/[^\/]+\//, "/download/v" version "/")
                sub(/git-all-.*-darwin-/, "git-all-" version "-darwin-")
                sub(/git-all-.*-linux-/, "git-all-" version "-linux-")
            }
            /darwin-arm64/ { platform = "darwin_arm64" }
            /darwin-x86_64/ { platform = "darwin_x86" }
            /linux-arm64/ { platform = "linux_arm64" }
            /linux-x86_64/ { platform = "linux_x86" }
            /sha256 "/ {
                if (platform == "darwin_arm64") sub(/sha256 "[^"]*"/, "sha256 \"" darwin_arm64 "\"")
                if (platform == "darwin_x86") sub(/sha256 "[^"]*"/, "sha256 \"" darwin_x86 "\"")
                if (platform == "linux_arm64") sub(/sha256 "[^"]*"/, "sha256 \"" linux_arm64 "\"")
                if (platform == "linux_x86") sub(/sha256 "[^"]*"/, "sha256 \"" linux_x86 "\"")
                platform = ""
            }
            { print }
        ' "$FORMULA" > "${FORMULA}.tmp"
        mv "${FORMULA}.tmp" "$FORMULA"
    fi

    echo ""
    if $DRY_RUN; then
        echo "Dry run complete. No changes made."
    else
        cat <<EOF
Formula updated: ${FORMULA}
Review and publish from the tap checkout:
  git diff
  git add Formula/git-all.rb
  git commit -m 'git-all ${VERSION}'
  git push
EOF
    fi
}

main "$@"
